# When adding environment variables, update the schema in src/env.ts as well.

APP_NAME="3D WebGIS Core"
APP_URL=http://localhost:3000

# PostgreSQL + PostGIS (required: vector layers are stored as PostGIS geometry).
# The queue (pg-boss) uses the same database in its own "pgboss" schema.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/cesium_core_next"

# NextAuth: generate with `npm run generate:auth` or `openssl rand -base64 32`
AUTH_SECRET=""
NEXTAUTH_URL=http://localhost:3000
# Idle lifetime of a session without "Remember me", in minutes
SESSION_LIFETIME=120
# Number of reverse proxies in front of the app that append to X-Forwarded-For (1 = one Nginx).
# The client IP for rate limits is taken that many hops from the right; 0 = trust no header.
TRUSTED_PROXY_COUNT=1

# OAuth sign-in (optional). A provider is enabled when both its ID and SECRET are set.
# OAuth links to an existing account with the same email; set AUTH_OAUTH_ALLOW_SIGNUP=true
# to create new "engineering" accounts for unknown emails instead of refusing them.
AUTH_OAUTH_ALLOW_SIGNUP=false
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Password reset mail (SMTP). Without MAIL_SMTP_ON=true the "forgot password" form tells
# users to contact an admin instead.
MAIL_SMTP_ON=false
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Geodata upload & conversion (Docker: GDAL + Cesium Terrain Builder)
GEODATA_MAX_UPLOAD_MB=1000
GEODATA_UPLOAD_SESSION_HOURS=24
GEODATA_UPLOAD_MAX_SESSIONS=4
GEODATA_UPLOAD_MAX_INFLIGHT_MB=2000
GEODATA_MIN_FREE_DISK_MB=512
GEODATA_ZIP_MAX_UNCOMPRESSED_MB=2000
GEODATA_DOCKER_COMPOSE_FILE=docker-compose.tools.yml
GEODATA_DOCKER_COMPOSE_BIN="docker compose"
# Match the worker process UID:GID and storage directory ownership on Linux.
GEODATA_CONVERTER_USER=1000:1000
# Runs the optional ezdxf colour parser on the HOST, outside the converter sandbox. Leave false
# unless every uploaded DXF is trusted (a parser bug would run with the worker's privileges).
GEODATA_ENABLE_PYTHON_COLOR_PARSER=false
GEODATA_TERRAIN_MIN_ZOOM=0
GEODATA_TERRAIN_MAX_ZOOM=15

# Coordinate system used for UTM display
GIS_UTM_ZONE=49
GIS_UTM_HEMISPHERE=N
