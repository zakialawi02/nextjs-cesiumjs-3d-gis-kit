{
  "name": "nextjs-cesiumjs-3d-gis-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run cesium:copy && next dev",
    "dev:all": "npm run cesium:copy && concurrently -c \"#93c5fd,#c4b5fd\" --names \"next,worker\" \"next dev\" \"npm run worker:dev\"",
    "build": "npm run cesium:copy && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch --clear-screen=false src/worker/index.ts",
    "geodata:cleanup-stale": "tsx src/scripts/cleanup-stale-uploads.ts",
    "cesium:copy": "node scripts/copy-cesium-assets.mjs",
    "generate:auth": "node scripts/generateAuth.js",
    "setup": "prisma migrate deploy && prisma db seed && npm run build",
    "postinstall": "prisma generate && node scripts/copy-cesium-assets.mjs",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "eslint && tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "^5.2.8",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/client": "~6.19.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.13.8",
    "bcryptjs": "^3.0.3",
    "cesium": "1.140.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^0.552.0",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "next": "^16.1.3",
    "next-auth": "^4.24.10",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "pg-query-stream": "^4.10.3",
    "prisma": "~6.19.0",
    "proj4": "^2.20.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.66.0",
    "swagger-ui-dist": "^5.34.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.6",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.0"
  }
}
